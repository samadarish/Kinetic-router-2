        {
          "language": "curl",
          "label": "cURL",
          "code": "curl https://api.kineticrouter.com/v1/chat/completions \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Authorization: Bearer $KINETICROUTER_API_KEY\" \\\n  -d '{\n    \"model\": \"openai/gpt-6-astra\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"Hello!\"}]\n  }'",
