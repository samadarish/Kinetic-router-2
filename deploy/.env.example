PORTAL_IMAGE_TAG=replace-with-an-immutable-release-or-commit-id
SESSION_COOKIE_NAME=__Host-kr_session
SESSION_ENCRYPTION_KEY=generate-a-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=604800
SERVER_TIMEZONE=Asia/Kolkata
ENABLE_KEY_WRITES=false
ENABLE_PROFILE_WRITES=false
ENABLE_REDEEM_WRITES=false
ENABLE_ANNOUNCEMENT_WRITES=false
# Configure Brevo SMTP and Google OAuth in Sub2API first.
ENABLE_EMAIL_SIGNUP=false
ENABLE_GOOGLE_SIGNIN=false
PUBLIC_SITE_ORIGINS=https://kineticrouter.com,https://www.kineticrouter.com
ANALYTICS_ENABLED=false
# Generate a long alphanumeric password and back up the analytics volume.
ANALYTICS_DB_PASSWORD=
# Optional separate support database; empty reuses the existing PostgreSQL database.
SUPPORT_DATABASE_URL=
LOG_LEVEL=info
