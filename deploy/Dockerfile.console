FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/site/package.json apps/site/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/bff/package.json apps/bff/package.json
COPY packages/platform-config/package.json packages/platform-config/package.json
COPY packages/brand-ui/package.json packages/brand-ui/package.json
COPY packages/portal-contract/package.json packages/portal-contract/package.json
COPY packages/sub2api-client/package.json packages/sub2api-client/package.json
RUN npm ci --no-audit --no-fund
COPY scripts scripts
COPY packages/platform-config packages/platform-config
COPY packages/brand-ui packages/brand-ui
COPY packages/portal-contract packages/portal-contract
COPY apps/console apps/console
RUN npm run build -w @kineticrouter/platform-config \
 && npm run build -w @kineticrouter/brand-ui \
 && npm run build -w @kineticrouter/portal-contract \
 && npm run build -w @kineticrouter/console

FROM nginx:1.29-alpine
COPY apps/console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
