FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/site/package.json apps/site/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/bff/package.json apps/bff/package.json
COPY packages/platform-config/package.json packages/platform-config/package.json
COPY packages/brand-ui/package.json packages/brand-ui/package.json
COPY packages/portal-contract/package.json packages/portal-contract/package.json
COPY packages/sub2api-client/package.json packages/sub2api-client/package.json
RUN npm ci --no-audit --no-fund
COPY packages/platform-config packages/platform-config
COPY packages/portal-contract packages/portal-contract
COPY packages/sub2api-client packages/sub2api-client
COPY apps/bff apps/bff
RUN npm run build -w @kineticrouter/platform-config \
 && npm run build -w @kineticrouter/portal-contract \
 && npm run build -w @kineticrouter/sub2api-client \
 && npm run build -w @kineticrouter/bff

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/site/package.json apps/site/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/bff/package.json apps/bff/package.json
COPY packages/platform-config/package.json packages/platform-config/package.json
COPY packages/brand-ui/package.json packages/brand-ui/package.json
COPY packages/portal-contract/package.json packages/portal-contract/package.json
COPY packages/sub2api-client/package.json packages/sub2api-client/package.json
RUN npm ci --omit=dev --no-audit --no-fund \
 --workspace @kineticrouter/bff \
 --workspace @kineticrouter/platform-config \
 --workspace @kineticrouter/portal-contract \
 --workspace @kineticrouter/sub2api-client \
 --include-workspace-root=false
COPY --from=build /app/apps/bff/dist apps/bff/dist
COPY --from=build /app/packages/platform-config/dist packages/platform-config/dist
COPY --from=build /app/packages/portal-contract/dist packages/portal-contract/dist
COPY --from=build /app/packages/sub2api-client/dist packages/sub2api-client/dist
USER node
EXPOSE 3101
HEALTHCHECK --interval=20s --timeout=5s --start-period=12s --retries=3 CMD node -e "fetch('http://127.0.0.1:3101/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/bff/dist/index.js"]
