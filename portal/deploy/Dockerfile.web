FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/bff/package.json apps/bff/package.json
COPY packages/portal-contract/package.json packages/portal-contract/package.json
COPY packages/sub2api-client/package.json packages/sub2api-client/package.json
RUN npm ci --no-audit --no-fund
COPY packages/portal-contract packages/portal-contract
COPY apps/web apps/web
RUN npm run build -w @kineticrouter/portal-contract && npm run build -w @kineticrouter/portal-web

FROM nginx:1.29-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
